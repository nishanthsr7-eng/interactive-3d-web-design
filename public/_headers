# Cloudflare Pages host rules. Copied into dist/ by scripts/build.mjs.

# Photos and the baked model geometry never change in place; cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Both JS bundles are content-hashed: a new build means a new URL, so the
# old one can be cached forever.
/js/*
  Cache-Control: public, max-age=31536000, immutable

# main.css is hand-written and not hashed, so it has to revalidate. The
# hashed wheel stylesheet gets the immutable rule.
/css/main.css
  Cache-Control: public, max-age=0, must-revalidate

/css/wheel-*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Applied on top of the rules above, which only set Cache-Control.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
